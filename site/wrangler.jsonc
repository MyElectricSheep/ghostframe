// The author's deployment. To deploy your own copy, start from wrangler.example.jsonc.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghostframe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  // Public since 2026-11-12 (the Access app was removed; ACCESS_AUD is "off").
  "routes": [{ "pattern": "ghostframe.electricsheep.id", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "containers": [
    {
      "class_name": "Engine",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../server/Dockerfile", "build_context": ".." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "Engine" }]
  },
  "exports": {
    "Engine": { "type": "durable-object", "storage": "sqlite" }
  },
  // Encodes per UTC day: 50 for the whole site (kept across sleeps in the Durable Object) and 3 per
  // visitor; "none" removes a cap. At 50 a day, CPU beyond the plan's included 375 vCPU-minutes costs
  // at most about $4 a month. GF_TURNSTILE_SECRET is a Worker secret.
  "vars": {
    "GF_SITE_DAILY_CAP": "50",
    "GF_VISITOR_DAILY_CAP": "3",
    "GF_ENCODE_TIMEOUT_S": "300",
    // With an Access app in front, set its AUD here and the Worker checks every request's token.
    "ACCESS_TEAM_DOMAIN": "electric-sheep.cloudflareaccess.com",
    "ACCESS_AUD": "off"
  }
}
