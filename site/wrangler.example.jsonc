// Copy to wrangler.jsonc and set your hostname. See site/README.md, "Deploy".
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghostframe",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-12",
  "routes": [{ "pattern": "ghostframe.example.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Keep console logs and errors; no log line per request.
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Only /api/* runs the Worker; pages and images are served straight from the assets, with the
    // headers in public/_headers.
    "run_worker_first": ["/api/*"]
  },
  // Per visitor (IPv6: per /64), per Cloudflare location: 10 POSTs (encode, decode, cancel) and 120
  // other API requests a minute. namespace_id must be unique within the Cloudflare account.
  "ratelimits": [
    { "name": "GF_POST_LIMIT", "namespace_id": "7301", "simple": { "limit": 10, "period": 60 } },
    { "name": "GF_API_LIMIT", "namespace_id": "7302", "simple": { "limit": 120, "period": 60 } }
  ],
  "containers": [
    {
      "class_name": "Engine",
      "scheduling_policy": "durable_object",
      "images": {
        "base": { "dockerfile": "../server/Dockerfile", "build_context": ".." }
      }
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "ENGINE", "class_name": "Engine" }]
  },
  "exports": {
    "Engine": { "type": "durable-object", "storage": "sqlite" }
  },
  // Daily caps per UTC day ("none" removes a cap): encodes 50 for the site and 3 per visitor,
  // decodes 1000 and 20. GF_TURNSTILE_SECRET is a Worker secret; without it, Hide and Read answer 503.
  "vars": {
    "GF_SITE_DAILY_CAP": "50",
    "GF_VISITOR_DAILY_CAP": "3",
    "GF_DECODE_SITE_DAILY_CAP": "1000",
    "GF_DECODE_VISITOR_DAILY_CAP": "20",
    "GF_ENCODE_TIMEOUT_S": "300"
  }
}
