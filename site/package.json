{
  "name": "ghostframe-site",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-assets": "node scripts/prepare-assets.mjs",
    "dev": "npm run prepare-assets && vite",
    "build": "npm run prepare-assets && npm run cf-types && tsc --noEmit && tsc -p worker/tsconfig.json && vite build && node scripts/verify-dist.mjs",
    "preview": "vite preview",
    "test:worker": "node --experimental-strip-types --test tests/worker-routes.mjs",
    "deploy": "npm run build && wrangler deploy",
    "cf-types": "wrangler types worker/worker-configuration.d.ts"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.1.1",
    "@fontsource/inter": "^5.1.1",
    "react": "^18.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.63.0",
    "typescript": "^5.7.3",
    "vite": "^6.4.6",
    "wrangler": "^4.160.1"
  }
}
